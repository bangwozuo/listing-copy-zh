{
  "workflow_id": "de_ecom_07_wf02",
  "name": "五点卖点生成",
  "type": "composite",
  "skill_refs": ["de_ecom_07_sk02", "de_ecom_07_sk03"],
  "dag": {
    "nodes": ["输入校验", "selling-point-copy", "adlaw-compliance-precheck", "汇总交付"],
    "edges": [
      ["输入校验", "selling-point-copy"],
      ["selling-point-copy", "adlaw-compliance-precheck"],
      ["adlaw-compliance-precheck", "汇总交付"]
    ],
    "loop": {"from": "adlaw-compliance-precheck", "to": "selling-point-copy", "max": 2, "condition": "红线 > 0"}
  },
  "input": {
    "type": "object",
    "required": ["platform", "product_info"],
    "properties": {
      "platform": {"type": "string", "enum": ["Amazon", "淘宝", "天猫", "抖音", "拼多多", "小红书"]},
      "product_info": {"type": "object", "description": "商品信息：品名、材质、规格、参数、已证实卖点、适用人群"},
      "points": {"type": "array", "items": {"type": "string"}, "description": "已有卖点；提供则只做校验与改写"},
      "evidence": {"type": "array", "items": {"type": "string"}, "description": "检测报告号、专利号、实测数据与样本量"},
      "category": {"type": "string", "description": "类目，决定闸门启用哪张禁词表"}
    }
  },
  "output": {
    "type": "object",
    "required": ["steps", "deliverable", "summary"],
    "properties": {
      "steps": {"type": "array", "description": "每步状态与关键结果"},
      "deliverable": {
        "type": "object",
        "properties": {
          "可用卖点": {"type": "array", "items": {"type": "string"}},
          "合规结论": {"type": "string", "enum": ["通过", "修改后上架", "不建议上架"]},
          "回环次数": {"type": "integer"},
          "产物": {"type": "array", "items": {"type": "string"}}
        }
      },
      "pending": {"type": "array", "description": "待整改项"},
      "summary": {"type": "object", "description": "执行结论与计数"}
    }
  },
  "scripts": {
    "run": "scripts/run_flow.py",
    "usage": "python3 scripts/run_flow.py --input input.json --outdir out"
  },
  "artifacts": ["out/流程执行报告.xlsx", "out/flow_result.json", "out/step2_point/", "out/step3_adlaw/"],
  "error_handling": {
    "input_missing": "列出缺失字段并中止",
    "fab_incomplete": "标注「补充收益」，可用条目继续",
    "red_line_hit": "回环改写，最多 2 次，超限中止",
    "no_usable_point": "跳过闸门，交付「无合规卖点」"
  },
  "constraints": {
    "external_api_required": false,
    "max_loop": 2,
    "gate_required": true,
    "ai_label_required": true,
    "human_review_required": true
  }
}
