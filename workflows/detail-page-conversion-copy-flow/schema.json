{
  "workflow_id": "de_ecom_07_wf04",
  "name": "详情页转化文案",
  "type": "composite",
  "skill_refs": [
    "de_ecom_07_sk02",
    "de_ecom_07_sk04",
    "de_ecom_07_sk03"
  ],
  "dag": [
    "输入校验 → selling-point-copy（五点卖点校验）",
    "selling-point-copy → conversion-structure-template（结构校验）",
    "conversion-structure-template → adlaw-compliance-precheck（广告法终审）",
    "三步通过 → 汇总交付"
  ],
  "input": {
    "type": "object",
    "required": ["platform", "product_info", "points", "modules", "text"],
    "properties": {
      "platform": {
        "type": "string",
        "description": "目标平台",
        "enum": ["淘宝", "天猫", "抖音", "小红书", "Amazon", "通用"]
      },
      "category": {
        "type": "string",
        "description": "商品类目，供广告法扫描启用类目禁词表（如化妆品）"
      },
      "product_info": {
        "type": "object",
        "description": "商品资料：品名 / 材质 / 规格 / 认证 / 场景"
      },
      "evidence": {
        "type": "array",
        "items": {"type": "string"},
        "description": "证据清单：检测报告号、认证编号、自测数据（写明样本量）"
      },
      "points": {
        "type": "array",
        "minItems": 5,
        "items": {"type": "string"},
        "description": "五点卖点条目（模型按 FAB 三层撰写，本流程逐条校验）"
      },
      "brief": {
        "type": "object",
        "description": "详情页简报：品类 / 品牌 / 核心卖点 / 目标人群 / 本店 SKU"
      },
      "modules": {
        "type": "array",
        "minItems": 6,
        "maxItems": 10,
        "items": {
          "type": "object",
          "properties": {
            "模块": {"type": "string"},
            "功能定位": {"type": "string"},
            "建议字数": {"type": "integer"},
            "素材状态": {"type": "string"},
            "文案": {"type": "string"}
          }
        },
        "description": "详情页模块结构，A+ 页面必备：品牌故事 / 对比表 / 场景图"
      },
      "sku_table": {
        "type": "array",
        "items": {"type": "object"},
        "description": "对比表 / 规格表（用于竞品贬低红线检测，不得含竞品名与贬低词）"
      },
      "text": {
        "type": "string",
        "maxLength": 5000,
        "description": "拼合后的全量文案（各模块文案 + 卖点条目），供广告法终审"
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["steps", "deliverable", "summary"],
    "properties": {
      "steps": {
        "type": "array",
        "description": "每步状态与关键结果（步骤 / 原子技能 / 状态 / 关键结果）"
      },
      "deliverable": {
        "type": "object",
        "description": "五点可用 / 结构待整改 / 广告法红线 / 最终结论",
        "properties": {
          "五点可用": {"type": "string"},
          "结构待整改": {"type": "integer"},
          "广告法红线": {"type": "integer"},
          "最终结论": {"type": "string", "enum": ["通过", "待整改"]}
        }
      },
      "fixes": {
        "type": "array",
        "description": "整改清单（来源步骤 / 问题 / 改法）"
      },
      "summary": {
        "type": "object",
        "description": "各步量化计数与最终结论"
      }
    }
  },
  "scripts": {
    "run_flow": "scripts/run_flow.py",
    "usage": "python3 scripts/run_flow.py --input input.json --outdir out；--demo 无输入演示"
  },
  "artifacts": [
    "out/流程执行报告.xlsx",
    "out/flow_result.json",
    "out/step2_selling/五点校验.xlsx",
    "out/step3_outline/详情页结构.xlsx",
    "out/step4_adlaw/广告法预审清单.xlsx"
  ],
  "acceptance": {
    "五点可用率": "100%",
    "模块数区间": "6-10",
    "A+必备模块": ["品牌故事", "对比表", "场景图"],
    "首屏字数上限": 120,
    "首屏统计范围": "前 3 个模块",
    "广告法红线": 0,
    "警告上限": 2,
    "竞品贬低命中": 0,
    "改写上限": "第 2/3 步各 2 轮"
  },
  "constraints": {
    "max_input_length": 5000,
    "ai_label_required": true,
    "human_review_required": true,
    "no_bypass_advice": true,
    "no_fabricated_evidence": true,
    "no_competitor_disparagement": true
  }
}
