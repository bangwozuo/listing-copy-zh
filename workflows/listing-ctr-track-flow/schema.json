{
  "workflow_id": "de_ecom_07_wf05",
  "name": "上架 CTR 追踪",
  "type": "composite",
  "skill_refs": [
    "de_ecom_07_sk01",
    "de_ecom_07_sk02",
    "de_ecom_07_sk05",
    "de_ecom_07_sk03",
    "de_ecom_07_sk04"
  ],
  "input": {
    "type": "object",
    "required": ["listing", "days"],
    "properties": {
      "listing": {
        "type": "object",
        "description": "现行 Listing 信息。platform 用于 CTR 健康带修正（抖音/拼多多信息流 1%~3%，其余搜索基准 2%~5%）",
        "properties": {
          "name": {"type": "string", "description": "商品名"},
          "platform": {"type": "string", "description": "淘宝/天猫/抖音/拼多多/Amazon"},
          "scene": {"type": "string", "description": "流量场景：搜索 / 推荐信息流"},
          "title": {"type": "string", "description": "现行标题，用于核心词覆盖与前置位置校验"},
          "core_keywords": {
            "type": "array",
            "items": {"type": "string"},
            "description": "核心词清单，缺失时定位降级为待排查"
          },
          "main_image_text": {"type": "string", "description": "主图上的文字/设计描述，用于牛皮癣与同质化判定"}
        }
      },
      "days": {
        "type": "array",
        "description": "现行版本每日数据。单日曝光 < 1000 只记录不判定；impressions=0 跳过",
        "items": {
          "type": "object",
          "required": ["date", "impressions", "clicks"],
          "properties": {
            "date": {"type": "string", "description": "日期 YYYY-MM-DD"},
            "impressions": {"type": "number", "description": "曝光量"},
            "clicks": {"type": "number", "description": "点击量"}
          }
        }
      },
      "ab_test": {
        "type": "object",
        "description": "A/B 测试分组。判胜前提：每组 ≥ 3 天且总曝光 ≥ 1000；胜出线 +20%，噪声线 +10%，曝光差 > 30% 不可比",
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string", "description": "组名，第一组为对照组 A"},
                "copy": {"type": "string", "description": "该组使用的标题/文案，胜出组进入合规预审"},
                "daily": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "date": {"type": "string"},
                      "impressions": {"type": "number"},
                      "clicks": {"type": "number"}
                    }
                  }
                }
              }
            }
          }
        }
      },
      "notes": {"type": "string", "description": "测试背景：何时换版、流量分配方式"}
    }
  },
  "output": {
    "type": "object",
    "required": ["summary", "daily", "abtest", "compliance", "diagnosis"],
    "properties": {
      "summary": {
        "type": "object",
        "description": "整体 CTR / 健康带 / 趋势斜率 / 判定 / AB 胜出组 / 合规拦截 / 基准表"
      },
      "daily": {
        "type": "array",
        "description": "日明细：日期/曝光/点击/CTR/曝光达标"
      },
      "abtest": {
        "type": "array",
        "description": "组别/天数/总曝光/CTR/相对A/判定（胜出/噪声/不确定/测试中/不可比）"
      },
      "compliance": {
        "type": "array",
        "description": "胜出变体合规扫描：级别/原文片段/命中规则/改法；红线词拦截上架"
      },
      "diagnosis": {
        "type": "array",
        "description": "问题定位：定位/证据/改法（CTR<1% 连续 ≥3 天必给改法）"
      }
    }
  },
  "scripts": [
    {
      "path": "scripts/run_flow.py",
      "usage": "python scripts/run_flow.py --input examples/input.json --outdir out | --demo",
      "description": "端到端编排：S1 数据校验 → S2 CTR 计算与判定（2%~5% 基准，<1% 连续 3 天判主图/标题问题）→ S3 证据式定位（keyword-combination/selling-point-copy 口径）→ S4 A/B 判胜（ab-copy-variant 纪律）→ S5 合规词表（adlaw-compliance-precheck 同源）→ S6 落位（conversion-structure-template 口径）",
      "modes": ["--input", "--demo"],
      "artifacts": [
        "out/CTR跟踪表.xlsx",
        "out/ctr_trend.png",
        "out/ctr_flow.json"
      ]
    }
  ],
  "constraints": {
    "ctr_band": "2%~5%（抖音/拼多多信息流 1%~3%，显式注明）",
    "problem_line": "CTR<1% 连续 ≥3 天判主图/标题问题并给改法",
    "min_day_impressions": 1000,
    "min_ab_days": 3,
    "min_group_impressions": 1000,
    "win_uplift": 0.20,
    "noise_uplift": 0.10,
    "imp_diff_incomparable": 0.30,
    "ai_label_required": true,
    "human_review_required": true,
    "forbidden": ["刷点击/互点/炒信", "极限词变体", "多变量同改"]
  }
}
